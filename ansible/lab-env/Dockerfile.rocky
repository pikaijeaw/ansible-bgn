# Managed node: Rocky Linux 9 (ตระกูล RHEL) + systemd + sshd
FROM rockylinux/rockylinux:9
# image ของ Rocky มากับ curl-minimal ซึ่งชนกับ curl ตัวเต็ม: --allowerasing สลับเป็น curl ตัวเต็มให้เหมือน server ทั่วไป
RUN dnf -y install --allowerasing systemd dbus-broker openssh-server python3 sudo iproute procps-ng curl \
 && dnf clean all \
 && useradd -m -s /bin/bash ansible \
 && echo "ansible ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/ansible \
 && mkdir -p /home/ansible/.ssh && chmod 700 /home/ansible/.ssh \
 && systemctl enable sshd.service \
 && rm -f /run/nologin
COPY .ssh/id_ed25519.pub /home/ansible/.ssh/authorized_keys
RUN chown -R ansible:ansible /home/ansible/.ssh && chmod 600 /home/ansible/.ssh/authorized_keys
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
