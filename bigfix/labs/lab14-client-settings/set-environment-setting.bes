<?xml version="1.0" encoding="UTF-8"?>
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
	<Task>
		<Title>Lab - Set client setting 'Environment' (Production/UAT/Dev)</Title>
		<Description><![CDATA[<P>ติด tag ให้เครื่องด้วย client setting แล้วนำไปใช้สร้าง Computer Group / targeting (ดู lab04)</P>]]></Description>
		<Relevance><![CDATA[true]]></Relevance>
		<Category>BigFix Administration</Category>
		<Source>Internal</Source>
		<SourceID></SourceID>
		<SourceReleaseDate>2026-10-29</SourceReleaseDate>
		<SourceSeverity></SourceSeverity>
		<CVENames></CVENames>
		<SANSID></SANSID>
		<MIMEField>
			<Name>x-fixlet-modification-time</Name>
			<Value>Thu, 29 Oct 2026 00:00:00 +0000</Value>
		</MIMEField>
		<Domain>BESC</Domain>
		<DefaultAction ID="Action1">
			<Description>
				<PreLink>Click </PreLink>
				<Link>here</Link>
				<PostLink> to deploy this action.</PostLink>
			</Description>
			<ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[action parameter query "Environment" with description "Production, UAT or Dev" and with default value "Production"
setting "Environment"="{parameter "Environment"}" on "{parameter "action issue date" of action}" for client
]]></ActionScript>
			<SuccessCriteria Option="RunToCompletion"></SuccessCriteria>
		</DefaultAction>
	</Task>
</BES>
