<?xml version="1.0" encoding="UTF-8"?>
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
	<Fixlet>
		<Title>Lab - Critical Windows services stopped (W32Time, WinRM, TermService)</Title>
		<Description><![CDATA[<P>relevant เมื่อ service สำคัญที่ตั้งเป็น Automatic หยุดทำงาน และ action จะ start ให้</P><P>ตั้งเป็น Policy Action: Take Action → Execution → <I>Reapply this action whenever it becomes relevant again</I></P>]]></Description>
		<Relevance><![CDATA[windows of operating system]]></Relevance>
		<Relevance><![CDATA[exists services whose ((service name of it as lowercase = "w32time" OR service name of it as lowercase = "winrm" OR service name of it as lowercase = "termservice") AND start type of it = "Automatic" AND state of it != "Running")]]></Relevance>
		<Category>Self Healing</Category>
		<Source>Internal</Source>
		<SourceID></SourceID>
		<SourceReleaseDate>2026-10-29</SourceReleaseDate>
		<SourceSeverity></SourceSeverity>
		<CVENames></CVENames>
		<SANSID></SANSID>
		<MIMEField>
			<Name>x-fixlet-modification-time</Name>
			<Value>Thu, 29 Oct 2026 00:00:00 +0000</Value>
		</MIMEField>
		<Domain>BESC</Domain>
		<DefaultAction ID="Action1">
			<Description>
				<PreLink>Click </PreLink>
				<Link>here</Link>
				<PostLink> to deploy this action.</PostLink>
			</Description>
			<ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[action uses wow64 redirection false
waithidden "{pathname of native system folder}\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -ExecutionPolicy Bypass -Command "Get-Service W32Time,WinRM,TermService | Where-Object {{ $_.StartType -eq 'Automatic' -and $_.Status -ne 'Running' } | Start-Service -PassThru | Out-File -Append C:\Windows\Temp\bigfix-service-heal.log"
]]></ActionScript>
			<SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
		</DefaultAction>
	</Fixlet>
</BES>
