<?xml version="1.0" encoding="UTF-8"?>
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
	<Fixlet>
		<Title>Lab - nginx service is not running (Linux)</Title>
		<Description><![CDATA[<P>Linux: ถ้ามี nginx ติดตั้งอยู่แต่ไม่ได้รัน ให้ start ใหม่</P>]]></Description>
		<Relevance><![CDATA[name of operating system as lowercase contains "linux"]]></Relevance>
		<Relevance><![CDATA[exists file "/usr/sbin/nginx"]]></Relevance>
		<Relevance><![CDATA[not exists file "/run/nginx.pid"]]></Relevance>
		<Category>Self Healing</Category>
		<Source>Internal</Source>
		<SourceID></SourceID>
		<SourceReleaseDate>2026-10-29</SourceReleaseDate>
		<SourceSeverity></SourceSeverity>
		<CVENames></CVENames>
		<SANSID></SANSID>
		<MIMEField>
			<Name>x-fixlet-modification-time</Name>
			<Value>Thu, 29 Oct 2026 00:00:00 +0000</Value>
		</MIMEField>
		<Domain>BESC</Domain>
		<DefaultAction ID="Action1">
			<Description>
				<PreLink>Click </PreLink>
				<Link>here</Link>
				<PostLink> to deploy this action.</PostLink>
			</Description>
			<ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[wait /bin/sh -c "systemctl restart nginx"
]]></ActionScript>
			<SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
		</DefaultAction>
	</Fixlet>
</BES>
