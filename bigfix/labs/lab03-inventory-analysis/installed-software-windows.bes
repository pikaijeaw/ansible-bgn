<?xml version="1.0" encoding="UTF-8"?>
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
	<Analysis>
		<Title>Lab - Installed Software (Windows)</Title>
		<Description><![CDATA[<P>รายการโปรแกรมที่ติดตั้งจาก registry Uninstall (ทั้ง 64 และ 32 bit) ไม่รวม system component</P>]]></Description>
		<Relevance><![CDATA[windows of operating system]]></Relevance>
		<Source>Internal</Source>
		<SourceID></SourceID>
		<SourceReleaseDate>2026-10-29</SourceReleaseDate>
		<SourceSeverity></SourceSeverity>
		<CVENames></CVENames>
		<SANSID></SANSID>
		<MIMEField>
			<Name>x-fixlet-modification-time</Name>
			<Value>Thu, 29 Oct 2026 00:00:00 +0000</Value>
		</MIMEField>
		<Domain>BESC</Domain>
		<Property Name="Installed Applications" ID="1" EvaluationPeriod="PT6H"><![CDATA[unique values of (value "DisplayName" of it as string & " | " & (if exists value "DisplayVersion" of it then value "DisplayVersion" of it as string else "n/a")) of keys whose (exists value "DisplayName" of it AND not exists value "SystemComponent" whose (it as integer = 1) of it) of keys "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of (x64 registries; x32 registries)]]></Property>
		<Property Name="Application Count" ID="2" EvaluationPeriod="PT6H"><![CDATA[number of unique values of (value "DisplayName" of it as string) of keys whose (exists value "DisplayName" of it) of keys "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of (x64 registries; x32 registries)]]></Property>
	</Analysis>
</BES>
