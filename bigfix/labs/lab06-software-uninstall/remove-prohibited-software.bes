<?xml version="1.0" encoding="UTF-8"?>
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
	<Fixlet>
		<Title>Lab - Remove prohibited software: TeamViewer</Title>
		<Description><![CDATA[<P>Fixlet แบบ compliance: relevant เมื่อเครื่องมีโปรแกรมต้องห้าม และกลายเป็น Fixed เมื่อถูกลบแล้ว</P><P>ตั้งเป็น <B>Policy Action</B> (reapply เมื่อ relevant อีก) เพื่อลบอัตโนมัติทุกครั้งที่มีคนลงกลับ</P>]]></Description>
		<Relevance><![CDATA[windows of operating system]]></Relevance>
		<Relevance><![CDATA[exists keys whose (exists value "DisplayName" whose (it as string as lowercase starts with "teamviewer") of it) of keys "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of (x64 registries; x32 registries)]]></Relevance>
		<Category>Security Compliance</Category>
		<Source>Internal</Source>
		<SourceID></SourceID>
		<SourceReleaseDate>2026-10-29</SourceReleaseDate>
		<SourceSeverity></SourceSeverity>
		<CVENames></CVENames>
		<SANSID></SANSID>
		<MIMEField>
			<Name>x-fixlet-modification-time</Name>
			<Value>Thu, 29 Oct 2026 00:00:00 +0000</Value>
		</MIMEField>
		<Domain>BESC</Domain>
		<DefaultAction ID="Action1">
			<Description>
				<PreLink>Click </PreLink>
				<Link>here</Link>
				<PostLink> to deploy this action.</PostLink>
			</Description>
			<ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[// Use the vendor UninstallString from the registry (+ /S for silent)
waithidden {(value "UninstallString" of key whose (exists value "DisplayName" whose (it as string as lowercase starts with "teamviewer") of it) of keys "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of (x64 registries; x32 registries)) as string} /S
]]></ActionScript>
			<SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
		</DefaultAction>
	</Fixlet>
</BES>
