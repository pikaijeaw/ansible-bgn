<?xml version="1.0" encoding="UTF-8"?>
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
	<Task>
		<Title>Lab - Install nginx on Ubuntu (shell script action)</Title>
		<Description><![CDATA[<P>ตัวอย่าง action แบบ <code>application/x-sh</code> (BigFix 9.5+) เขียน bash ได้ตรงๆ</P>]]></Description>
		<Relevance><![CDATA[name of operating system as lowercase contains "linux"]]></Relevance>
		<Relevance><![CDATA[exists file "/etc/os-release" whose (exists lines whose (it = "ID=ubuntu") of it)]]></Relevance>
		<Relevance><![CDATA[not exists file "/usr/sbin/nginx"]]></Relevance>
		<Category>Software Distribution</Category>
		<Source>Internal</Source>
		<SourceID></SourceID>
		<SourceReleaseDate>2026-10-29</SourceReleaseDate>
		<SourceSeverity></SourceSeverity>
		<CVENames></CVENames>
		<SANSID></SANSID>
		<MIMEField>
			<Name>x-fixlet-modification-time</Name>
			<Value>Thu, 29 Oct 2026 00:00:00 +0000</Value>
		</MIMEField>
		<Domain>BESC</Domain>
		<DefaultAction ID="Action1">
			<Description>
				<PreLink>Click </PreLink>
				<Link>here</Link>
				<PostLink> to deploy this action.</PostLink>
			</Description>
			<ActionScript MIMEType="application/x-sh"><![CDATA[#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update -q
apt-get install -y -q nginx
systemctl enable --now nginx
curl -fsS http://localhost/ >/dev/null
]]></ActionScript>
			<SuccessCriteria Option="RunToCompletion"></SuccessCriteria>
		</DefaultAction>
	</Task>
</BES>
